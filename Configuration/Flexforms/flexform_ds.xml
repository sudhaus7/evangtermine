<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:pluginsheet.general</sheetTitle>
                <type>array</type>
                <el>
                    <settings.etkey_vid>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.vid</label>
                        <!-- entspricht userId -->
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <eval>trim</eval>
                        </config>
                    </settings.etkey_vid>
                    <settings.etkey_q>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.et_q</label>
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <eval>trim</eval>
                        </config>
                    </settings.etkey_q>
                    <settings.etkey_highlight>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.highlight</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.highlight.high</label>
                                    <value>high</value>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.highlight.all</label>
                                    <value>all</value>
                                </numIndex>
                            </items>
                            <default>all</default>
                        </config>
                    </settings.etkey_highlight>
                    <settings.etkey_eventtype>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.eventtype</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingleBox</renderType>
                            <size>6</size>
                            <maxitems>25</maxitems>
                            <itemsProcFunc>ArbkomEKvW\Evangtermine\Util\CategoryUtil->getCategories</itemsProcFunc>
                            <default>all</default>
                        </config>
                    </settings.etkey_eventtype>
                    <settings.etkey_people>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.people</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingleBox</renderType>
                            <size>6</size>
                            <maxitems>25</maxitems>
                            <itemsProcFunc>ArbkomEKvW\Evangtermine\Util\CategoryUtil->getGroups</itemsProcFunc>
                            <default>all</default>
                        </config>
                    </settings.etkey_people>
                    <settings.etkey_regions>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.regions</label>
                        <description>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.onlyForImportEvents</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingleBox</renderType>
                            <size>6</size>
                            <itemsProcFunc>ArbkomEKvW\Evangtermine\Util\CategoryUtil->getRegions</itemsProcFunc>
                            <default>all</default>
                        </config>
                    </settings.etkey_regions>
                    <settings.etkey_subregions>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.subregions</label>
                        <description>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.onlyForImportEvents</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingleBox</renderType>
                            <size>6</size>
                            <itemsProcFunc>ArbkomEKvW\Evangtermine\Util\CategoryUtil->getSubregions</itemsProcFunc>
                            <default>all</default>
                        </config>
                    </settings.etkey_subregions>
                    <settings.etkey_region2>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.regions2</label>
                        <description>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.onlyForImportEvents</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingleBox</renderType>
                            <size>6</size>
                            <itemsProcFunc>ArbkomEKvW\Evangtermine\Util\CategoryUtil->getRegions2</itemsProcFunc>
                            <default>all</default>
                        </config>
                    </settings.etkey_region2>
                    <settings.etkey_region3>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.regions3</label>
                        <description>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.onlyForImportEvents</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingleBox</renderType>
                            <size>6</size>
                            <itemsProcFunc>ArbkomEKvW\Evangtermine\Util\CategoryUtil->getRegions3</itemsProcFunc>
                            <default>all</default>
                        </config>
                    </settings.etkey_region3>
                    <settings.etkey_places>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.places</label>
                        <description>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.onlyForImportEvents</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingleBox</renderType>
                            <size>6</size>
                            <itemsProcFunc>ArbkomEKvW\Evangtermine\Util\CategoryUtil->getPlaces</itemsProcFunc>
                            <default>all</default>
                        </config>
                    </settings.etkey_places>
                    <settings.etkey_itemsPerPage>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.itemsPerPage</label>
                        <config>
                            <type>number</type>
                            <size>20</size>
                            <default>20</default>
                            <eval>trim</eval>
                        </config>
                    </settings.etkey_itemsPerPage>
                    <settings.evt_addprms>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.addprms</label>
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <eval>trim</eval>
                        </config>
                    </settings.evt_addprms>
                </el>
            </ROOT>
        </sDEF>
        <cdistrict>
            <ROOT>
                <sheetTitle>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:pluginsheet.cdistrict</sheetTitle>
                <type>array</type>
                <el>
                    <settings.etkey_region>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.region</label>
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <eval>trim</eval>
                        </config>
                    </settings.etkey_region>
                    <settings.etkey_aid>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.aid</label>
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <eval>trim</eval>
                        </config>
                    </settings.etkey_aid>
                </el>
            </ROOT>
        </cdistrict>
        <opmode>
            <ROOT>
                <sheetTitle>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:pluginsheet.opmode</sheetTitle>
                <type>array</type>
                <el>
                    <settings.opmode_detailpage>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.detailpage</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                        </config>
                    </settings.opmode_detailpage>
                    <settings.hide_place_names>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hidePlaceNames</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_place_names>
                    <settings.etkey_hideOngoingEvents>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hideOngoingEvents</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.etkey_hideOngoingEvents>
                </el>
            </ROOT>
        </opmode>
        <form>
            <ROOT>
                <sheetTitle>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:pluginsheet.searchform</sheetTitle>
                <type>array</type>
                <el>
                    <settings.toggleAllFilters>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.toggleAllFilters</label>
                        <config>
                            <type>check</type>
                            <fieldInformation>
                                <toggleAllFilters>
                                    <renderType>toggleAllFilters</renderType>
                                </toggleAllFilters>
                            </fieldInformation>
                        </config>
                    </settings.toggleAllFilters>
                    <settings.hide_highlights>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hideHighlights</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_highlights>
                    <settings.hide_categories>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hideCategories</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_categories>
                    <settings.hide_target_audience>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hideTargetAudience</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_target_audience>
                    <settings.hide_regions>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hideRegions</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_regions>
                    <settings.hide_places>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hidePlaces</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_places>
                    <settings.hide_zip_search>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hideZipSearch</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_zip_search>
                    <settings.hide_searchword>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hideSearchword</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_searchword>
                    <settings.hide_date>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hideDate</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_date>
                    <settings.hide_hideOngoingEvents>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hide_hideOngoingEvents</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_hideOngoingEvents>
                    <settings.hide_itemsPerPage>
                        <label>LLL:EXT:evangtermine/Resources/Private/Language/locallang.xlf:feflexform.hideItemsPerPage</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hide_itemsPerPage>
                </el>
            </ROOT>
        </form>
    </sheets>
</T3DataStructure>
